flowchart TD
  %% Detailed integer LayerNorm -> certified e-graph -> A* semantic closure.
  %% Agda is proof authority. Exact integer arithmetic is the computational substrate.
  %% A* supplies traversal guidance only; it never supplies semantic equality.

  subgraph INPUT["Exact integer LayerNorm input"]
    X["x = [x₁ … xₙ]\nList Int8 ≡ List ℤ"]
    N["n = length x"]
    S["S = Σ xᵢ"]
    X --> N
    X --> S
  end

  subgraph CENTER["Exact integer centering"]
    D["Dᵢ = n·xᵢ − S"]
    DS["centered numerators\n[D₁ … Dₙ]"]
    N --> D
    S --> D
    X --> D
    D --> DS
  end

  subgraph VAR["Exact variance/radicand"]
    SQ["square : ℤ → ℤ\nz ↦ z·z"]
    V["V = Σ Dᵢ²"]
    EPS["ε·n²"]
    R["R = V + ε·n²"]
    DS --> SQ
    SQ --> V
    N --> EPS
    V --> R
    EPS --> R
  end

  subgraph CERT["Explicit normalization certificate"]
    C0["IntegerLayerNormCertificate"]
    ROOT["root : Nat"]
    ROOTSQ["root² ≡ R"]
    ROOTNZ["root ≠ 0"]
    C0 --> ROOT
    C0 --> ROOTSQ
    C0 --> ROOTNZ
    R --> ROOTSQ
    ROOT --> ROOTSQ
  end

  subgraph OUT["Exact normalized representation"]
    CFG["IntegerLayerNormConfig\nfixedScale, γ, β : Int8"]
    NUM["γ·(scale·Dᵢ) + β·root"]
    DEN["denominator = root"]
    RAT["IntegerLayerNormValue\nexact integer ratio"]
    CFG --> NUM
    DS --> NUM
    ROOT --> NUM
    ROOT --> DEN
    NUM --> RAT
    DEN --> RAT
    ROOTNZ --> RAT
  end

  subgraph EGRAPH["Certified semantic e-graph"]
    RAW["rawIntegerLayerNorm ε x"]
    CEN["centeredIntegerLayerNorm ε x"]
    RAD["radicandIntegerLayerNorm ε x"]
    EDGE1["CertifiedEGraphEdge\nraw → centered"]
    EDGE2["CertifiedEGraphEdge\ncentered → radicand"]
    CONG["EGraphCongruence\nrefl / sym / trans"]
    SEM["EGraphSemanticInterpretation\nsound relation → equality"]
    PATH["EGraphSemanticPath"]
    RAW --> EDGE1 --> CEN
    CEN --> EDGE2 --> RAD
    EDGE1 --> CONG
    EDGE2 --> CONG
    CONG --> SEM
    SEM --> PATH
  end

  DS --> CEN
  R --> RAD
  RAT -. "exact statistics retained in semantic state" .-> SEM

  subgraph PLANALG["A* plan algebra"]
    PM["AStarPlanMonoidTheorem\nList(Expression), ++-monoid"]
    PA["append associative"]
    PL["append identity left"]
    PR["append identity right"]
    PM --> PA
    PM --> PL
    PM --> PR
    AM["AStarHaskellMonadSurface\nState frontier + List candidates"]
    PM --> AM
  end

  subgraph ASTAR["A* semantic transport"]
    PLAN["candidate proof path"]
    COST["AStarCostModel\nedgeCost + heuristic"]
    BEST["cost-guided representative"]
    SOUND["aStar-guided-semantic-closure"]
    EQ["interpret e ≡ interpret f"]
    AM --> PLAN
    PLAN --> COST
    COST --> BEST
    BEST --> PATH
    PATH --> SOUND
    SOUND --> EQ
    SEM --> COST
    PM --> PLAN
  end

  subgraph REPO["Repository proof boundary"]
    T["TheoremsMonolith.agda"]
    A1["CanonicalIntegerLayerNormEGraphAStarTheorem"]
    A2["UnconditionalAgdaEGraphAStarClosure"]
    DHC["Dhall semantic-contract gate"]
    T --> A1
    A1 --> A2
    A2 --> DHC
  end

  subgraph LNSTABILITY["LayerNorm-specific stability and growth"]
    LNS["IntegerLayerNormConfigurationStabilityTheorem"]
    LNR["IntegerLayerNormEpsilonRayGrowthTheorem"]
    LNL["linear radicand ray\nR(ε) = V + ε·n²"]
    LNG["CanonicalIntegerLayerNormStabilityGrowthTheorem"]
    F4LN["CanonicalF4IntegerLayerNormStabilityBoundaryTheorem\nF4 stability + LayerNorm stability boundary"]
    LNS --> LNG
    LNR --> LNL
    LNR --> LNG
    LNG --> F4LN
  end

  A1 --> LNS
  A1 --> LNR
  F4LN -. "separate typed families; no NormPair replacement" .-> F6
  EQ --> A1
  A1 --> A2

  subgraph NONCLAIMS["Explicit boundaries"]
    F1["No floating-point arithmetic"]
    F2["No hidden rounding theorem"]
    F3["No injectivity claim for quantized LayerNorm"]
    F4["GRU → feature-vector projection is a separate typed seam"]
    F5["A* cost/heuristic ≠ equality evidence"]
    F6["LayerNorm ε-ray ≠ F4 optimizer-state ray"]
  end

  C0 --> F1
  RAT --> F2
  RAT -. "does not entail" .-> F3
  F4 -. "future composition" .-> X
  COST --> F5
  LNR -. "distinct arithmetic growth mechanism" .-> F6

  subgraph FUTURE["Future composition"]
    G0["explicit GRU feature projection"]
    G1["integer LayerNorm over GRU feature vector"]
    G2["LayerNorm-aware GRU transition theorem"]
    G3["global injectivity / conjugacy contract"]
    G0 --> G1 --> G2 --> G3
  end

  F4 --> G0
  RAT --> G1

  classDef proof fill:#e8f0ff,stroke:#356ac3,stroke-width:2px;
  classDef frontier fill:#fff4d6,stroke:#b8860b,stroke-width:2px;
  classDef blocked fill:#ffe8e8,stroke:#b33,stroke-width:2px;
  class C0,ROOT,ROOTSQ,ROOTNZ,EDGE1,EDGE2,CONG,SEM,PATH,SOUND,A1,A2,DHC proof;
  class F4,G0,G1,G2,G3 frontier;
  class F3 blocked;
