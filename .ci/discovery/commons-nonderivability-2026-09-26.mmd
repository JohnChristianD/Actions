flowchart TD
  LO["Individual/local optimality"] --> EXT["Private extraction"]
  EXT --> CO["One-unit shared resource"]
  CO --> AGG["Two-unit aggregate extraction"]
  AGG -. "capacity violated" .-> X["X Unconditional commons preservation"]
  X -. "countermodel" .-> TC["Tragedy-of-the-commons non-derivability"]

  LO --> MC["Market clearing"]
  MC -. "not sufficient" .-> X
  MC --> PRICE["Supporting / derived price"]
  PRICE --> WE["Walrasian equilibrium"]
  PRICE -. "not a commons-preservation theorem" .-> X

  CO --> COUP["Explicit coupling"]
  COUP --> CONS["Aggregate conservation"]
  CONS --> SUST["Sustainable allocation"]

  subgraph NESTED["Nested / self-similar commons"]
    L0["Level 0 commons"] --> L1["Level 1 commons"]
    L1 --> LN["Level n commons"]
    L0 -. "same preservation obligation" .-> NP["NestedCommonsPreservationDerivation"]
    L1 -. "same preservation obligation" .-> NP
    LN -. "same preservation obligation" .-> NP
    NP -. "fails at any inhabited level" .-> NX["X Unconditional nested preservation"]
  end

  X --> NX
  NX -. "formal witness" .-> TWO["TwoScaleCommonsLevel"]
  TWO --> TC2["noUnconditionalNestedCommonsPreservation-twoScale"]
  AGG --> SUM["Aggregate = extraction₁ + extraction₂"]
  SUM --> TC
