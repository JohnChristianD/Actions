le\": \"Promote only through the existing fully connected composition. CanonicalLearnerReplacementClosureTheorem is absorbed here as a semantic dependency and is not an independent function-class separation node.\",\n    \"novelty_basis\": \"This is materially different from the prior finite-automaton and tropical candidates: the endogenous object is the exact policy-preserving quotient induced by the learner-replacement action itself.\"\n  },\n  \"complete_graph_contract_v6\": {\n    \"future_entry\": \"Future theorem candidates may use automata, tropical geometry, or the exact learner-replacement action, but every candidate must enter through a real composed parent with an actual Agda dependency and be discoverable by both graph search and e-graph synchronization.\",\n    \"disconnected_pruning\": \"No-dependency records are never promoted by conceptual similarity. If a composed theorem already consumes them, record that real promotion; otherwise retain them only as foundational proof-surface facts.\",\n    \"strict_graph_invariant\": \"Strict neural-function-class separation remains only F_base -> full connected composition -> F_full_connected.\",\n    \"separation_gate\": \"SEPARATED requires explicit resource-preserving inclusion, connected witness membership, and canonical baseline nonrepresentability on the Agda surface.\"\n  },\n  \"separation_contracts\": {\n    \"agda_records\": [\n      \"FunctionClassInclusion\",\n      \"StrictFunctionClassSeparation\",\n      \"CanonicalStrictNeuralFunctionClassSeparationContract\"\n    ],\n    \"semantic_obligations\": [\n      \"input/output semantics preserving F_base subseteq F_full_connected\",\n      \"concrete witness f in F_full_connected traversing the connected composition\",\n      \"canonical proof f notin F_base\"\n    ],\n    \"status\": \"CONTRACT_ADDED_NOT_PROVED\",\n    \"promotion_rule\": \"A concrete candidate changes to SEPARATED only when a model-specific Agda term inhabits the contract and Agda --safe verifies it.\",\n    \"research_basis\": \"Peer-reviewed recurrent expressivity work commonly separates representation and lower-bound/impossibility obligations; the repository adopts the same witness-plus-nonrepresentability discipline without importing external claims as proof.\"\n  },\n  \"candidate_specific_contracts\": {\n    \"automata_sign_optimizer_affine\": {\n      \"theorem\": \"canonicalAutomataSignOptimizerAffineGRUStrictSeparationTheorem\",\n      \"status\": \"LITERATURE_ALIGNED_BASELINE_COMPLETED_ROUTE_SPECIFIC_UNPROVED\"\n    },\n    \"non_tropical\": {\n      \"theorem\": \"canonicalNonTropicalSignOptimizerAffineGRUStrictSeparationTheorem\",\n      \"status\": \"LITERATURE_ALIGNED_BASELINE_COMPLETED_ROUTE_SPECIFIC_UNPROVED\"\n    },\n    \"non_tropical_non_automata\": {\n      \"theorem\": \"canonicalNonTropicalNonAutomataSignOptimizerAffineGRUStrictSeparationTheorem\",\n      \"status\": \"LITERATURE_ALIGNED_BASELINE_COMPLETED_ROUTE_SPECIFIC_UNPROVED\"\n    },\n    \"replacement_quotient\": {\n      \"theorem\": \"canonicalSignOptimizerAffineReplacementQuotientGRUStrictSeparationTheorem\",\n      \"status\": \"LITERATURE_ALIGNED_BASELINE_COMPLETED_ROUTE_SPECIFIC_UNPROVED\"\n    },\n    \"shared_separation_basis\": \"CanonicalFullLearnerConnectedScanConjugacyTheorem\"\n  },\n  \"parallel_scan_complexity_boundary\": {\n    \"name\": \"CanonicalConnectedCompositionLogarithmicSIMDSpanCandidate\",\n    \"status\": \"CANDIDATE_NOT_PROVED\",\n    \"parent\": \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n    \"real_dependencies\": [\n      \"RecurrentAssociativeScanTheorem\",\n      \"RecurrentPrefixMonoidHomomorphism\",\n      \"EfficientOperatorMonoidRepresentation\",\n      \"LogarithmicScanSpanCertificate\"\n    ],\n    \"claim_boundary\": \"If the connected recurrent transition admits an efficient associative operator representation, exact prefix scan, bounded representation/decoding overhead, and a genuine logarithmic-depth scan certificate, then horizon-H evaluation has O(log H) parallel span up to constant seam overhead and O(H) work under the supplied cost model.\",\n    \"proof_status\": \"Conditional theorem surface added; no concrete SIMD/PRAM logarithmic scan certificate is yet present in the repository.\",\n    \"important_non_implication\": \"Conjugacy, left-invertibility, and exactness alone do not imply O(log H) span.\",\n    \"no_synthetic_edge\": true\n  },\n  \"novel_exotic_pregraphed_theorems\": [\n    {\n      \"name\": \"CanonicalEndogenousAperiodicClockRNNStrictSeparationCandidate\",\n      \"status\": \"CANDIDATE_NOT_PROVED\",\n      \"parent\": \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n      \"literature_basis\": \"finite-state/rational recurrence versus unbounded state-space growth\",\n      \"path\": [\n        \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n        \"canonicalConnectedLearnerClock-realization\",\n        \"canonicalDeterministicFiniteStepDivergenceInevitability\",\n        \"CanonicalFullLearnerConnectedScanConjugacyTheorem\"\n      ],\n      \"required_certificates\": [\n        \"explicit input/output semantics for the clock transduction\",\n        \"resource-preserving baseline inclusion\",\n        \"connected witness membership\",\n        \"baseline nonrepresentability\",\n        \"observation-topology transport\"\n      ],\n      \"no_synthetic_edge\": true\n    },\n    {\n      \"name\": \"CanonicalEndogenousRationalRecurrenceBoundaryCandidate\",\n      \"status\": \"CANDIDATE_NOT_PROVED\",\n      \"parent\": \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n      \"literature_basis\": \"rational recurrence/WFA state expressivity boundary\",\n      \"path\": [\n        \"CanonicalFullLearnerConnectedScanConjugacyTheorem\"\n      ],\n      \"candidate_statement\": \"Characterize the exact boundary between the finite-factor/rational-recurrence observation quotient and the nonrecurrent exact learner state, without identifying factor recurrence with exact-state recurrence.\",\n      \"required_certificates\": [\n        \"actual Agda rational-recurrence class definition\",\n        \"factor-to-WFA or equivalent recurrence witness\",\n        \"exact-state/non-factor distinction\",\n        \"connected observation transport\"\n      ],\n      \"no_synthetic_edge\": true\n    },\n    {\n      \"name\": \"CanonicalEndogenousStateSpaceConjugacyExpressivityBoundaryCandidate\",\n      \"status\": \"CANDIDATE_NOT_PROVED\",\n      \"parent\": \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n      \"literature_basis\": \"RNN hierarchy separation by state expressivity and space complexity\",\n      \"path\": [\n        \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n        \"DenseNeighborhoodSeparationTheorem\",\n        \"FullCommutingSquareConjugacyTheorem\"\n      ],\n      \"candidate_statement\": \"Use an explicit state-space conjugacy to transport a strict witness/nonrepresentability boundary through the connected learner, rather than treating topology or neighborhood separation as standalone expressivity claims.\",\n      \"required_certificates\": [\n        \"explicit state-space conjugacy\",\n        \"same-witness neighborhood separation\",\n        \"observation topology compatibility\",\n        \"baseline inclusion\",\n        \"baseline nonrepresentability\"\n      ],\n      \"no_synthetic_edge\": true\n    },\n    {\n      \"name\": \"ConnectedMaxwellTsallisExactConjugacyTheorem\",\n      \"status\": \"PROVED_CONDITIONAL_ON_EXACT_CONJUGACY_DATA\",\n      \"parent\": \"MaxwellExactConjugacyData\",\n      \"path\": [\n        \"MaxwellExactConjugacyData\",\n        \"ConnectedMaxwellTsallisExactConjugacyTheorem\"\n      ],\n      \"distinction\": \"Carrier-polymorphic Maxwell/Tsallis exact transition conjugacy over an arbitrary carrier. No finite-function transport or Fin n carrier is required.\",\n      \"required_certificates\": [\n        \"MaxwellExactConjugacyData\",\n        \"exact encode/decode inverse laws\",\n        \"Maxwell closure\",\n        \"exact transition conjugacy\",\n        \"carrier-polymorphic Tsallis/divergence structure\",\n        \"divergence transport law\"\n      ],\n      \"physical_scope\": \"Maxwell equations only; no additional physical laws are admitted implicitly.\",\n      \"exactness_boundary\": \"Exactness applies to the explicitly supplied Maxwell transition and divergence structure. It does not assert existence of a GRU representation for an arbitrary Maxwell solution space.\",\n      \"no_synthetic_edge\": true\n    },\n    {\n      \"name\": \"ConnectedF4MaxwellFiniteDivergenceRegretCompositionCandidate\",\n      \"status\": \"CANDIDATE_NOT_PROVED\",\n      \"parent\": \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n      \"path\": [\n        \"CanonicalFullLearnerConnectedScanConjugacyTheorem\",\n        \"CanonicalGRUF4NormWatkinsPrefixCompositionTheorem\",\n        \"ConnectedF4FrankWolfeRoundingBiasRegretTheorem\",\n        \"ConnectedMaxwellTsallisExactConjugacyTheorem\"\n      ],\n      \"candidate_statement\": \"Compose the sole F4 custom optimizer, its genuine horizon-indexed cumulative regret theorem, and the finite Maxwell/Tsallis exact-conjugacy seam without importing a standalone optimizer or KKT endpoint.\",\n      \"required_certificates\": [\n        \"F4 exact GRU-Watkins composition\",\n        \"cumulative horizon law\",\n        \"F4 residual regret bound\",\n        \"finite Maxwell semantics\",\n        \"exact finite encoding/decoding\",\n        \"exact conjugacy\",\n        \"finite Tsallis/divergence transport\",\n        \"shared finite state semantics\"\n      ],\n      \"no_synthetic_edge\": true\n    },\n    {\n      \"name\": \"ConnectedContinuousHodgeMaxwellGRURepresentationTheorem\",\n      \"status\": \"PROVED_CONDITIONAL_ON_EXACT_REPRESENTATION_SEMANTICS\",\n      \"parent\": \"ContinuousHodgeMaxwellExactRepresentationData\",\n      \"path\": [\n        \"ContinuousHodgeMaxwellExactRepresentationData\",\n        \"ConnectedContinuousHodgeMaxwellGRURepresentationTheorem\"\n      ],\n      \"candidate_statement\": \"Exact GRU translation of every explicitly supplied continuous differential-form Hodge-Maxwell solution family over an arbitrary GRU carrier.\",\n      \"required_certificates\": [\n        \"exact differential-form semantics for Form2, FormStar, and Form3\",\n        \"exact Maxwell equations dF=0 and d(star F)=j\",\n        \"explicit continuity witnesses\",\n        \"global exact encode/decode inverse laws\",\n        \"global StateIsomorphism\",\n        \"exact recurrent transition conjugacy\",\n        \"Maxwell closure\"\n      ],\n      \"physical_scope\": \"Maxwell/Hodge-Maxwell differential-form semantics only.\",\n      \"exactness_boundary\": \"The theorem is exact for the declared continuous solution family and supplied GRU carrier. It does not assert existence of such a certificate for every physical or infinite-dimensional Maxwell solution space.\",\n      \"no_synthetic_edge\": true,\n      \"distinction\": \"Exact theorem for every explicitly supplied family of exact differential-form Hodge-Maxwell solutions, with an arbitrary GRU carrier, exact encode/decode StateIsomorphism, continuity witnesses, Maxwell-equation preservation, and recurrent transition conjugacy. It does not assert existence of such a certificate for every physical or infinite-dimensional Maxwell solution space.\",\n      \"quantitative_contract\": \"dF = 0 and d(star F) = j are carried exactly through the supplied global state isomorphism and recurrent transition conjugacy.\",\n      \"promotion_gate\": \"The differential-form semantics, continuity predicates, exact encoder/decoder, state isomorphism, closure, and conjugacy are explicit Agda fields; universal existence of those witnesses remains outside the theorem.\"\n    },\n    {\n      \"name\": \"ConnectedMaxwellContinuousPDERepresentationCandidate\",\n      \"status\": \"CANDIDATE_NOT_PROVED\",\n      \"parent\": \"ConnectedContinuousHodgeMaxwellGRURepresentationTheorem\",\n      \"path\": [\n        \"ConnectedContinuousHodgeMaxwellGRURepresentationTheorem\",\n        \"ConnectedMaxwellContinuousPDERepresentationCandidate\"\n      ],\n      \"candidate_statement\": \"Exact representation of a declared continuous Maxwell solution/function space over an arbitrary GRU carrier.\",\n      \"required_certificates\": [\n        \"formal differential-form/function-space semantics\",\n        \"well-posed domain, metric, source, and boundary conditions\",\n        \"continuity witnesses\",\n        \"exact GRU representation over the chosen function-space carrier\",\n        \"preservation of dF=0 and d(star F)=j\",\n        \"exact encode/decode or an explicit function-space StateIsomorphism\"\n      ],\n      \"impossibility_boundary\": \"The carrier-polymorphic theorem proves representation consequences once these witnesses exist; it does not prove that every continuous Maxwell solution space admits such a representation.\",\n      \"no_synthetic_edge\": true\n    },\n    {\n      \"name\": \"RegularWalrasianExistenceAdapterCandidate\",\n      \"status\": \"CANDIDATE_NOT_PROVED\",\n      \"parent\": \"GeneralizedWalrasianEquilibrium\",\n      \"path\": [\n        \"Econlib::RegularEconomy\",\n        \"Econlib::Economy.exists_equilibrium\",\n        \"Actions::staticWalrasian\",\n        \"Actions::GeneralizedWalrasianEquilibrium\",\n        \"Actions::MarkovStationaryWalrasianCompositionTheorem\"\n      ],\n      \"literature_basis\": \"upstream regular-economy existence plus local generalized/stationary Walrasian transport\",\n      \"candidate_statement\": \"Complete regular finite Walrasian existence by constructing an explicit cross-language adapter from the external regular-economy existence witness into local staticWalrasian, then compose the existing static-to-generalized stationary lift.\",\n      \"required_certificates\": [\n        \"external theorem object adapter\",\n        \"equivalence between upstream WalrasianEquilibrium and local staticWalrasian\",\n        \"local stationary invariant law\",\n        \"explicit generalized equilibrium witness\"\n      ],\n      \"no_synthetic_edge\": true\n    }\n  ],\n  \"transformative_recent_commits_since_graph_contract\": [\n    {\n      \"sha\": \"565d39e5b99442a2970c31e753ec6a58bdf45166\",\n      \"message\": \"Upgrade Agda Int8 carrier to unbounded Z\",\n      \"transformative\": true\n    },\n    {\n      \"sha\": \"2bd6ba249fc6a5b47ced328ad84dcf9a9403686a\",\n      \"message\": \"Separate exact Int8 ring algebra from finite observations\",\n      \"transformative\": true\n    },\n    {\n      \"sha\": \"c26a4b55d874afeea410c6472ef1aa824c28fc19\",\n      \"message\": \"Reconnect finite pigeonhole boundaries through retired finite-observation layer observations\",\n      \"transformative\": true\n    },\n    {\n      \"sha\": \"3ef3d14b6d2aa2d0b317e16826bc3d9fc03876ce\",\n      \"message\": \"Prune duplicate theorem boundaries and make endogenous finite observations explicit\",\n      \"transformative\": false\n    },\n    {\n      \"sha\": \"aeb81e06e4d06eeb7576961dd2bfa810616e3908\",\n      \"message\": \"Repair F4 finite observation promotion without duplicate expansion\",\n      \"transformative\": true\n    }\n  ],\n  \"complete_graph_contract_v7\": {\n    \"future_entry\": \"Every future theorem, candidate, topology result, neighborhood result, conjugacy result, or optimizer-specific descent result must name a real composed Agda parent and be discoverable by theorem_graph_search plus theorem_monolith_egraph_sync.\",\n    \"promotion_order\": \"foundational theorem -> smallest existing composed consumer -> full connected learner -> F_full_connected\",\n    \"disconnected_pruning\": \"No-dependency theorems are removed from the strict separation graph as independent nodes. Their proof records remain available only when required by a consuming composed theorem; otherwise they are classified foundational and not graph-promoted.\",\n    \"strict_invariant\": \"Only F_base -> full connected composition -> F_full_connected participates in strict function-class separation.\",\n    \"upgrade_gate\": \"SEPARATED requires explicit resource-preserving inclusion, a connected witness, and canonical baseline nonrepresentability.\",\n    \"novel_candidate_rule\": \"New exotic candidates are pre-graphed only when they have an explicit parent/path and literature-motivated algebraic shape; candidate status never substitutes for an Agda proposition or proof.\",\n    \"no_synthetic_edges\": true,\n    \"f4_frank_wolfe\": \"Every future F4/Frank-Wolfe theorem must be downstream of the exact F4 recurrent composition and must terminate in a connected consumer; standalone gap/KKT claims remain dependencies.\",\n    \"maxwell\": \"Every future physics theorem must explicitly declare Maxwell-only scope, finite encoding, and exact representation/conjugacy; no extra physical law is admitted implicitly.\"\n  },\n  \"maxwell_status\": {\n    \"status\": \"CARRIER_POLYMORPHIC_CONTINUOUS_SEMANTICS\",\n    \"surviving_surface\": \"ConnectedContinuousHodgeMaxwellGRURepresentationTheorem\",\n    \"scope\": \"Exact differential-form Maxwell/Hodge-Maxwell semantics over an arbitrary GRU carrier; no Fin n state bound.\",\n    \"representation_gate\": [\n      \"explicit differential-form objects and equations\",\n      \"explicit continuity witnesses\",\n      \"exact encode/decode StateIsomorphism\",\n      \"exact recurrent conjugacy\",\n      \"explicit global encode-injectivity\"\n    ],\n    \"global_injectivity\": \"PROVED_CONDITIONAL on the supplied exact representation certificate\",\n    \"continuous_pde_boundary\": \"No existence theorem for arbitrary infinite-dimensional Maxwell solution spaces is inferred without explicit function-space/domain/metric/source/boundary semantics and an exact GRU representation certificate.\",\n    \"hodge_involution\": \"PROVED_CONDITIONAL on the explicit GRU involution and observed factorization\",\n    \"no_synthetic_edge\": true,\n    \"noninjectivity_boundary\": {\n      \"status\": \"PROVED_CONDITIONAL\",\n      \"theorem\": \"hodgeMaxwell-globalEncode-noninjective-refutes-connected-representation\",\n      \"scope\": \"arbitrary GRU carrier; no Fin n dependency\",\n      \"limitation\": \"requires an explicit collision witness; it does not prove that every continuous Maxwell solution space has such a collision\"\n    },\n    \"pruned_finite_dependencies\": [\n      \"finite Hodge-Maxwell discretization surfaces\",\n      \"finite-carrier Maxwell/Tsallis branches\",\n      \"finite-carrier Maxwell pigeonhole boundary\"\n    ],\n    \"arbitrary_solution_space_quantifier\": \"For every instantiated ContinuousHodgeMaxwellExactRepresentationData GRU, the field Solution is an arbitrary Set carrier: no fixed dimension, Fin n bound, or finite enumeration is assumed. The connected representation theorem is universally instantiable over every such supplied solution carrier and arbitrary GRU carrier.\",\n    \"global_injectivity_scope\": \"continuousHodgeMaxwell-global-encode-injective proves the encoder is injective over the entire Solution carrier of the supplied representation datum: for all x y in that Solution, encode x ≡ encode y implies x ≡ y. This is global within one arbitrary solution space, not merely local, finite, or observation-image injectivity.\",\n    \"representation_existence_boundary\": \"The theorem does not prove that every mathematically possible Hodge-Maxwell solution space admits a continuous GRU representation. The exact universal statement is: for every supplied representation datum, its arbitrary Solution carrier receives the exact global StateIsomorphism and global encoder injectivity proved by the Agda theorem.\",\n    \"set_of_sets_family_boundary\": \"A literal family/set-of-sets is a universe-lifted or dependent-family object (for example I : Set and A : I → Set, with a dependent sum in Set₁); it is not the same claim as one arbitrary Solution : Set. No cross-family injectivity theorem is claimed or needed by the current Hodge-Maxwell surface. Such a family-wide theorem must introduce an indexed family and a dependent encoder before graph admission.\",\n    \"finite_dimensional_boundary\": \"A continuous finite-dimensional Hodge-Maxwell specialization is graphable only after an explicit finite-dimensional function-space certificate is added. The current Agda surface does not encode finite-dimensionality, so no finite-dimensional existence theorem is promoted.\",\n    \"z_role\": \"ℤ remains the exact unbounded algebraic carrier for the canonical learner; it does not replace arbitrary Maxwell function-space carriers.\",\n    \"finite_dimensional_composition\": {\n      \"theorem\": \"ConnectedFiniteDimensionalHodgeMaxwellGRUF4WatkinsEGraphCompositionTheorem\",\n      \"status\": \"PROVED_ON_AGDA_SURFACE\",\n      \"dimension_parameter\": \"n : Nat\",\n      \"coordinate_carrier\": \"Fin n → Scalar\",\n      \"certificate\": \"StateIsomorphism from the arbitrary Maxwell Solution carrier of the connected representation to the finite coordinate carrier\",\n      \"result\": \"global injectivity of the finite-coordinate observation on CanonicalFullLearnerState, derived from the connected learner-to-solution left inverse and coordinate isomorphism\",\n      \"semantic_limit\": \"This is the repository's exact finite-dimensional-coordinate specialization. The theorem monolith does not currently formalize vector-space/module axioms or prove that every physically defined finite-dimensional Maxwell solution space admits such a coordinate certificate.\",\n      \"no_fin_n_maxwell_base\": \"The base Hodge-Maxwell representation remains carrier-polymorphic; Fin n appears only in this explicit specialization.\"\n    }\n  },\n  \"automation_contract\": {\n    \"graphing\": \"The canonical Agda monolith is the only theorem source. learner_semantic_extractor.m discovers declarations/dependencies; theorem_graph_search.m performs A* dependency discovery; theorem_monolith_egraph_sync.m ingests the discovered plans into the e-graph. Dhall orchestrates these modules but does not define theorem edges.\",\n    \"future_theorems\": \"Every future theorem declaration is extracted from the canonical Agda monolith, dependency-searched by theorem_graph_search.m, and offered to theorem_monolith_egraph_sync.m. A theorem becomes strict graph material only when an actual composed consumer exists; candidate physics/optimizer nodes remain pregraphed until their explicit certificates are present.\"\n  },\n  \"excluded_from_strict_graph\": [],\n  \"custom_optimizer_boundary\": {\n    \"policy\": \"F4 is the only custom optimizer.\",\n    \"contract\": \"For every finite horizon H, cumulative regret R(H) is generated by per-round regret r(H): R(0)=0 and R(H+1)=R(H)+r(H), with R(H) ≤ J(H)+B(H)+W(H)+M(H).\",\n    \"terms\": \"J is Jensen/minimax contribution; B rounding bias; W the F4/Frank-Wolfe residual; M stationary/Markov residual.\",\n    \"strict_endpoint\": \"ConnectedF4FrankWolfeRoundingBiasRegretTheorem\",\n    \"excluded\": [\n      \"Lion\",\n      \"standalone KKT\",\n      \"standalone Frank-Wolfe\",\n      \"generic custom optimizer\"\n    ]\n  },\n  \"nlab_semantic_boundary\": {\n    \"maxwell\": \"nLab presents Maxwell equations in differential-form form dF=0 and d⋆F=j_el; the repository now declares those semantics over an arbitrary carrier, but this does not prove that every continuous Maxwell solution space admits a GRU representation.\",\n    \"tsallis\": \"The current Agda TsallisDivergenceStructure is a carrier-polymorphic divergence/transition shell. It does not formalize a q-log/q-exponential identity, finite measured-space entropy semantics, or q-log differentiability/convexity; those remain explicit candidate obligations.\",\n    \"conjugacy\": \"nLab's conjugation-action viewpoint is compatible with the repository's encode/decode transition-intertwining law. The carrier-polymorphic Maxwell/Tsallis conjugacy does not require a finite carrier.\",\n    \"q_log\": \"A q-log/q-exponential generalization cannot be promoted from the presence of a qLog-named learner state field. A future q-log theorem must formalize the operation, q parameter/domain, exact identities, and any claimed trigonometric or spherical-plane consequences before graph admission.\"\n  },\n  \"legacy_graph_surface\": {\n    \"pruned_disconnected_theorems\": [\n      \"ConnectedCustomOptimizerRoundingBiasRegretTheorem\",\n      \"ConnectedF4FrankWolfeKKTTheorem\",\n      \"ConnectedLionJensenMinimaxRegretRoundingKKTMarkovTheorem\",\n      \"ConnectedF4FrankWolfeJensenRoundingKKTMarkovTheorem\",\n      \"ConnectedJensenMinimaxRegretOptimizerTheorem\",\n      \"FiniteHardSparseKKTEquilibriumTheorem\",\n      \"UniqueKKTAbsorbingClass\"\n    ],\n    \"reason\": \"Removed from canonical source, strict graph, CI plan, and theorem index because no retained strict composed theorem depends on them.\"\n  },\n  \"future_theorem_graph_contract\": {\n    \"entry\": \"Every future theorem must be an actual Agda declaration.\",\n    \"dependency\": \"It must have at least one real proof-relevant dependency or be explicitly foundational.\",\n    \"consumer\": \"A theorem intended as a strict endpoint must be consumed by a composed theorem; otherwise it remains foundational/candidate-only.\",\n    \"finite_carrier\": \"retired finite-observation layer may appear only where a finite observation/factor is explicit; it must never be used to re-bound the exact Int8=ℤ carrier.\",\n    \"graph\": \"Every new connected theorem must add a real edge and a consuming parent in the same change; finite observation must be explicit, and exact Int8=Z must never be silently re-bounded.\",\n    \"automation\": \"learner_semantic_extractor.m → theorem_graph_search.m → theorem_monolith_egraph_sync.m\"\n  },\n  \"complete_graph_contract_v8\": {\n    \"future_entry\": \"Every future theorem must be an actual Agda declaration with a real parent dependency or an explicitly foundational role.\",\n    \"regret_rule\": \"Any future regret theorem must expose cumulative regret as a function of horizon H; a scalar Nat inequality is insufficient for a horizon-regret endpoint.\",\n    \"optimizer_rule\": \"Optimizer-specific facts must terminate in a consuming connected regret theorem; no standalone Lion, KKT, or Frank-Wolfe endpoint.\",\n    \"f4_rule\": \"F4/Frank-Wolfe regret consumers must depend directly on CanonicalGRUF4NormWatkinsPrefixCompositionTheorem.\",\n    \"physics_rule\": \"Hodge-Maxwell/Maxwell exact representation is carrier-polymorphic; finite exact representations remain a special case and may not be promoted into a universal continuous-PDE existence theorem without explicit function-space semantics and an exact GRU certificate.\",\n    \"automation\": \"learner_semantic_extractor.m → theorem_graph_search.m → theorem_monolith_egraph_sync.m.\",\n    \"no_synthetic_edges\": true\n  },\n  \"no_disconnected_optimizer_endpoints\": {\n    \"pruned\": [\n      \"ConnectedCustomOptimizerRoundingBiasRegretTheorem\",\n      \"ConnectedF4FrankWolfeKKTTheorem\",\n      \"ConnectedLionJensenMinimaxRegretRoundingKKTMarkovTheorem\",\n      \"ConnectedF4FrankWolfeJensenRoundingKKTMarkovTheorem\",\n      \"ConnectedJensenMinimaxRegretOptimizerTheorem\",\n      \"FiniteHardSparseKKTEquilibriumTheorem\",\n      \"UniqueKKTAbsorbingClass\"\n    ],\n    \"retained\": [\n      \"ConnectedF4FrankWolfeRoundingBiasRegretTheorem\"\n    ],\n    \"horizon_contract\": \"R(0)=0; R(H+1)=R(H)+r(H); for every H, R(H) ≤ J(H)+B(H)+W(H)+M(H).\"\n  },\n  \"qsa_boundary\": {\n    \"status\": \"RESEARCH_BOUNDARY\",\n    \"exact_algebraic_core\": \"Finite deterministic QSA identities can be formalized over Nat or exact rationals without real analysis.\",\n  