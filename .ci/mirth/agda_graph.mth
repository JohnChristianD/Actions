module actions.agda_graph

import std.prelude
import std.world

def main {
    "set -euo pipefail; out=\"${1:?output Elm module path}\"; learner=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; extract_symbols() { tag=\"$1\"; file=\"$2\"; awk -v tag=\"$tag\" 'function emit(name) { gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", name); if(name != \"\") print tag \"\t\" name} /^[[:space:]]*$/ {next} /^--/ {next} /^record[[:space:]]+/ {emit($2); next} /^data[[:space:]]+/ {emit($2); next} /^module[[:space:]]+/ {emit($2); next} /^[^[:space:]][^:]*:[[:space:]]/ {name=$0; sub(/:[[:space:]].*$/, \"\", name); emit(name); next}' \"$file\" > \"$tmp/$tag.symbols\"; }; extract_symbols learner \"$learner\" & p1=$!; extract_symbols theorem \"$theorem\" & p2=$!; if ! wait \"$p1\"; then exit 1; fi; if ! wait \"$p2\"; then exit 1; fi; cat \"$tmp/learner.symbols\" \"$tmp/theorem.symbols\" > \"$tmp/symbols\"; awk -F '\\t' 'BEGIN{OFS=FS} {id=$1 \":\" $2; names[id]=1; byTag[$1 SUBSEP $2]=id; globalCount[$2]++; if(globalCount[$2]==1) globalId[$2]=id; else globalId[$2]=\"\"} END{for(id in names){split(id,p,\":\"); print id,p[1],p[2]}}' \"$tmp/symbols\" | sort > \"$tmp/nodes.tsv\"; build_edges() { tag="$1"; file="$2"; awk -F '\\t' -v tag="$tag" 'BEGIN{OFS=FS} NR==FNR {id=$1; split(id,p,":"); byTag[p[1] SUBSEP p[2]]=id; next} function emit(  cleaned,key,p,name,normalizedName) { if(current=="") return; cleaned=block; gsub(/[^A-Za-z0-9_-]+/, " ", cleaned); cleaned=" " cleaned " "; for(key in byTag){split(key,p,SUBSEP); if(p[1]!=tag || p[2]==current) continue; name=p[2]; normalizedName=name; gsub(/[^A-Za-z0-9_-]+/, " ", normalizedName); if(index(cleaned, " " normalizedName " ")>0) print tag ":" current, byTag[key], "references"} } function start(name){emit(); current=name; block=""} /^[[:space:]]*$/ {if(current!="") block=block " \\n "; next} /^--/ {next} /^record[[:space:]]+/ {start($2); next} /^data[[:space:]]+/ {start($2); next} /^module[[:space:]]+/ {start($2); next} /^[^[:space:]][^:]*:[[:space:]]/ {name=$0; sub(/:[[:space:]].*$/, "", name); gsub(/^[[:space:]]+|[[:space:]]+$/, "", name); start(name); block=block " " $0; next} {if(current!="") block=block " " $0} END{emit()}' "$tmp/nodes.tsv" "$file" > "$tmp/$tag.edges"; }; build_edges learner "$learner"; build_edges theorem "$theorem"; { printf '%s\\n' 'module GeneratedAgdaGraph exposing (Node, Edge, nodes, edges)'; printf '\\n%s\\n' 'type alias Node = { id : String, label : String, source : String }'; printf '%s\\n' 'type alias Edge = { source : String, target : String, relation : String }'; printf '\\nnodes : List Node\\n'; printf '%s\\n' 'nodes = ['; awk -F '\\t' '{if(NR>1) printf \"    ,\\n\"; printf \"    { id = \\\"%s\\\", label = \\\"%s\\\", source = \\\"%s\\\" }\\n\", $1, $3, $2}' \"$tmp/nodes.tsv\"; printf '%s\\n' ']'; printf '\\nedges : List Edge\\n'; printf '%s\\n' 'edges = ['; cat \"$tmp/learner.edges\" \"$tmp/theorem.edges\" | sort -u | awk -F '\\t' '{if(NR>1) printf \"    ,\\n\"; printf \"    { source = \\\"%s\\\", target = \\\"%s\\\", relation = \\\"%s\\\" }\\n\", $1, $2, $3}'; printf '%s\\n' ']'; } > \"$out\"; printf '%s\\n' 'Generated Agda declaration graph:' \"$out\"; wc -l \"$out\"; " print
}
