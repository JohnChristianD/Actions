module actions.agda_graph

import std.prelude
import std.world

def main {
    "set -euo pipefail; out=\"${1:?output Elm module path}\"; learner=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; extract_symbols() { tag=\"$1\"; file=\"$2\"; awk -v tag=\"$tag\" 'function emit(name) { gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", name); if(name != \"\") print tag \"\t\" name} /^[[:space:]]*$/ {next} /^--/ {next} /^record[[:space:]]+/ {emit($2); next} /^data[[:space:]]+/ {emit($2); next} /^module[[:space:]]+/ {emit($2); next} /^[^[:space:]][^:]*:[[:space:]]/ {name=$0; sub(/:[[:space:]].*$/, \"\", name); emit(name); next}' \"$file\" > \"$tmp/$tag.symbols\"; }; extract_symbols learner \"$learner\" & p1=$!; extract_symbols theorem \"$theorem\" & p2=$!; if ! wait \"$p1\"; then exit 1; fi; if ! wait \"$p2\"; then exit 1; fi; cat \"$tmp/learner.symbols\" \"$tmp/theorem.symbols\" > \"$tmp/symbols\"; awk -F '\\t' 'BEGIN{OFS=FS} {id=$1 \":\" $2; names[id]=1; byTag[$1 SUBSEP $2]=id; globalCount[$2]++; if(globalCount[$2]==1) globalId[$2]=id; else globalId[$2]=\"\"} END{for(id in names){split(id,p,\":\"); print id,p[1],p[2]}}' \"$tmp/symbols\" > \"$tmp/nodes.tsv\"; build_edges() { tag=\"$1\"; file=\"$2\"; awk -F '\\t' -v tag=\"$tag\" 'BEGIN{OFS=FS} FILENAME==ARGV[1] {id=$1; split(id,p,\":\"); names[id]=1; byTag[p[1] SUBSEP p[2]]=id; globalCount[p[2]]++; if(globalCount[p[2]]==1) globalId[p[2]]=id; else globalId[p[2]]=\"\"; next} function flush(  cleaned,n,i,t,target) { if(current==\"\") return; cleaned=block; gsub(/[^A-Za-z0-9_-]+/, \" \", cleaned); n=split(cleaned,tokens,/ +/); for(i=1;i<=n;i++){t=tokens[i]; if(t==\"\" || t==current) continue; target=byTag[tag SUBSEP t]; if(target==\"\"){ if(globalId[t]!=\"\") target=globalId[t]; else continue } print tag \":\" current, target, \"references\"} } function start(name){flush(); current=name; block=\"\"} /^[[:space:]]*$/ {if(current!=\"\") block=block \" \\n \"; next} /^--/ {next} /^record[[:space:]]+/ {start($2); next} /^data[[:space:]]+/ {start($2); next} /^module[[:space:]]+/ {start($2); next} /^[^[:space:]][^:]*:[[:space:]]/ {name=$0; sub(/:[[:space:]].*$/, \"\", name); gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", name); start(name); block=block \" \" $0; next} {if(current!=\"\") block=block \" \" $0} END{flush()}' \"$tmp/nodes.tsv\" \"$file\" > \"$tmp/$tag.edges\"; }; build_edges learner \"$learner\" & p3=$!; build_edges theorem \"$theorem\" & p4=$!; if ! wait \"$p3\"; then exit 1; fi; if ! wait \"$p4\"; then exit 1; fi; { printf '%s\\n' 'module GeneratedAgdaGraph exposing (Node, Edge, nodes, edges)'; printf '\\n%s\\n' 'type alias Node = { id : String, label : String, source : String }'; printf '%s\\n' 'type alias Edge = { source : String, target : String, relation : String }'; printf '\\nnodes : List Node\\n'; printf '%s\\n' 'nodes = ['; awk -F '\\t' '{if(NR>1) printf "    ,\\n"; printf "    { id = \\\"%s\\\", label = \\\"%s\\\", source = \\\"%s\\\" }\\n", $1, $3, $2}' \"$tmp/nodes.tsv\"; printf '%s\\n' ']'; printf '\\nedges : List Edge\\n'; printf '%s\\n' 'edges = ['; cat \"$tmp/learner.edges\" \"$tmp/theorem.edges\" | sort -u | awk -F '\\t' '{if(NR>1) printf "    ,\\n"; printf "    { source = \\\"%s\\\", target = \\\"%s\\\", relation = \\\"%s\\\" }\\n", $1, $2, $3}'; printf '%s\\n' ']'; } > \"$out\"; printf '%s\\n' 'Generated Agda declaration graph:' \"$out\"; wc -l \"$out\"; " print
}
