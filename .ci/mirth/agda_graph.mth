module actions.agda_graph

import std.prelude
import std.world

def main {
    "set -euo pipefail; out=\"${1:?output Elm module path}\"; learner=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; extract_symbols() { tag=\"$1\"; file=\"$2\"; awk -v tag=\"$tag\" 'function emit(name) { gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", name); if(name != \"\") print tag \"\t\" name} /^[[:space:]]*$/ {next} /^--/ {next} /^record[[:space:]]+/ {emit($2); next} /^data[[:space:]]+/ {emit($2); next} /^module[[:space:]]+/ {emit($2); next} /^[^[:space:]][^:]*:([[:space:]]|$)/ {name=$0; sub(/[[:space:]]*:[[:space:]]*.*$/, \"\", name); emit(name); next}' \"$file\" > \"$tmp/$tag.symbols\"; }; extract_symbols learner \"$learner\" & p1=$!; extract_symbols theorem \"$theorem\" & p2=$!; if ! wait \"$p1\"; then exit 1; fi; if ! wait \"$p2\"; then exit 1; fi; cat \"$tmp/learner.symbols\" \"$tmp/theorem.symbols\" > \"$tmp/symbols\"; awk -F '\\t' 'BEGIN{OFS=FS} {id=$1 \":\" $2; names[id]=1; byTag[$1 SUBSEP $2]=id; globalCount[$2]++; if(globalCount[$2]==1) globalId[$2]=id; else globalId[$2]=\"\"} END{for(id in names){split(id,p,\":\"); print id,p[1],p[2]}}' \"$tmp/symbols\" | sort > \"$tmp/nodes.tsv\"; build_edges() { tag=\"$1\"; file=\"$2\"; awk -F '\\t' -v tag=\"$tag\" 'BEGIN{OFS=FS} NR==FNR {id=$1; split(id,p,\":\"); byTag[p[1] SUBSEP p[2]]=id; next} function emit_refs( cleaned,n,i,t,target) { if(current==\"\") return; cleaned=block; gsub(/[^A-Za-z0-9_-]+/, \" \", cleaned); n=split(cleaned,tokens,/ +/); for(i=1;i<=n;i++){t=tokens[i]; if(t==\"\" || t==current) continue; target=byTag[tag SUBSEP t]; if(target!=\"\") print tag \":\" current, target, \"references\"} } function start(name){emit_refs(); current=name; block=\"\"} /^[[:space:]]*$/ {if(current!=\"\") block=block \" \\n \"; next} /^--/ {next} /^record[[:space:]]+/ {start($2); next} /^data[[:space:]]+/ {start($2); next} /^module[[:space:]]+/ {start($2); next} /^[^[:space:]][^:]*:([[:space:]]|$)/ {name=$0; sub(/[[:space:]]*:[[:space:]]*.*$/, \"\", name); gsub(/^[[:space:]]+|[[:space:]]+$/, \"\", name); start(name); block=block \" \" $0; next} {if(current!=\"\") block=block \" \" $0} END{emit_refs()}' \"$tmp/nodes.tsv\" \"$file\" > \"$tmp/$tag.edges\"; }; build_edges learner \"$learner\"; build_edges theorem \"$theorem\"; { printf '%s\\n' 'module GeneratedAgdaGraph exposing (Node, Edge, nodes, edges)'; printf '\\n%s\\n' 'type alias Node = { id : String, label : String, source : String }'; printf '%s\\n' 'type alias Edge = { source : String, target : String, relation : String }'; printf '\\nnodes : List Node\\n'; printf '%s\\n' 'nodes = ['; first=1; while IFS=$'\\t' read -r id source label; do if [ \"$first\" -eq 0 ]; then printf '    ,\\n'; else first=0; fi; printf '    { id = \\\"%s\\\", label = \\\"%s\\\", source = \\\"%s\\\" }\\n' \"$id\" \"$label\" \"$source\"; done < \"$tmp/nodes.tsv\"; printf '%s\\n' ']'; printf '\\nedges : List Edge\\n'; printf '%s\\n' 'edges = ['; first=1; while IFS=$'\\t' read -r source target relation; do if [ \"$first\" -eq 0 ]; then printf '    ,\\n'; else first=0; fi; printf '    { source = \\\"%s\\\", target = \\\"%s\\\", relation = \\\"%s\\\" }\\n' \"$source\" \"$target\" \"$relation\"; done < <(cat \"$tmp/learner.edges\" \"$tmp/theorem.edges\" | sort -u > \"$tmp/edges.tsv\"; emit_chunked_records() { kind=\"$1\"; type=\"$2\"; file=\"$3\"; awk -F '\\t' -v kind=\"$kind\" -v type=\"$type\" '
BEGIN {
  chunk=0; count=0; first=1;
  printf \"%sChunk%d : List %s\\n\", kind, chunk, type;
  printf \"%sChunk%d = [\\n\", kind, chunk;
}
{
  if (!first) print \"    ,\";
  first=0;
  if (type == \"Node\")
    printf \"    { id = \\\"%s\\\", label = \\\"%s\\\", source = \\\"%s\\\" }\\n\", $1, $3, $2;
  else
    printf \"    { source = \\\"%s\\\", target = \\\"%s\\\", relation = \\\"%s\\\" }\\n\", $1, $2, $3;
  count++;
  if (count == 128) {
    print \"]\";
    chunk++;
    count=0;
    first=1;
    printf \"\\n%sChunk%d : List %s\\n\", kind, chunk, type;
    printf \"%sChunk%d = [\\n\", kind, chunk;
  }
}
END {
  print \"]\";
  printf \"\\n%s : List %s\\n%s = \", kind, type, kind;
  for (i=0; i<=chunk; i++) {
    if (i>0) printf \" ++ \";
    printf \"%sChunk%d\", kind, i;
  }
  printf \"\\n\";
}
' \"$file\"; }; { printf '%s\\n' 'module GeneratedAgdaGraph exposing (Node, Edge, nodes, edges)'; printf '\\n%s\\n' 'type alias Node = { id : String, label : String, source : String }'; printf '%s\\n' 'type alias Edge = { source : String, target : String, relation : String }'; emit_chunked_records nodes Node \"$tmp/nodes.tsv\"; emit_chunked_records edges Edge \"$tmp/edges.tsv\"; } > \"$out\"; printf '%s\\n' 'Generated Agda declaration graph:' \"$out\"; wc -l \"$out\"; " print
