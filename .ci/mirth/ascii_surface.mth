module actions.ascii_surface

import std.prelude
import std.world

def main {
    "#!/usr/bin/env bash
set -euo pipefail
python3 - <<'PY'
from pathlib import Path
import subprocess

files = subprocess.check_output(['git', 'ls-files', '*.md', '*.markdown', '*.elm'], text=True).splitlines()
for raw in files:
    path = Path(raw)
    data = path.read_bytes()
    bad = sorted({byte for byte in data if byte > 0x7f})
    if bad:
        rendered = ','.join(f'0x{byte:02x}' for byte in bad)
        raise SystemExit(f'{path}: non-ASCII bytes: {rendered}')

print(f'ASCII surface synchronized: {len(files)} tracked Markdown/Elm files')
PY" print
}
