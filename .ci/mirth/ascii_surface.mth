module actions.ascii_surface

import std.prelude
import std.world

def main {
    "set -euo pipefail; files=$(git ls-files '*.md' '*.markdown' '*.elm' '*.html' '*.js'); for file in $files; do if LC_ALL=C grep -n '[^[:print:][:space:]]' \"$file\" >/dev/null; then echo \"non-ASCII surface: $file\" >&2; exit 1; fi; done; echo \"ASCII surface synchronized: $(printf '%s\\\\n' \"$files\" | sed '/^$/d' | wc -l) tracked Markdown/Elm files\"" print
}
