module actions.agda_import_sync


def main {
    "set -euo pipefail; mode=\"--write\"; if [ \"$#\" -gt 0 ]; then mode=\"$1\"; fi; canonical=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; lockdir=.ci/.mirth-agda-import-sync.lock; global=$(mktemp); imports=$(mktemp); safe_imports=$(mktemp); unsafe_modules=$(mktemp); trap 'rm -f \"$global\" \"$imports\"; rmdir \"$lockdir\" 2>/dev/null || true' EXIT INT TERM; acquire_lock() { attempt=0; until mkdir \"$lockdir\" 2>/dev/null; do attempt=$((attempt + 1)); if [ \"$attempt\" -ge 200 ]; then echo \"mirth-agda-import-sync: lock timeout\" >&2; exit 1; fi; sleep 0.05; done; }; sources() { git ls-files \"*.agda\"; }; module_imports() { while IFS= read -r file; do sed -e '/^-- BEGIN MIRTH-SYNC GLOBAL IMPORTS$/,/^-- END MIRTH-SYNC GLOBAL IMPORTS$/d' \"$file\"; done < <(sources) | sed -n 's/^\\(open \\)\\?import \\([A-Za-z0-9_.]*\\).*/\\2/p' | grep -v -E '^(FullCoupled\\.CanonicalLearnerMonolith|FullCoupled\\.TheoremsMonolith)$' | sort -u; }; extract_unsafe() { while IFS= read -r file; do if grep -Eq '^[[:space:]]*postulate([[:space:]]|$)' "$file"; then sed -n 's/^module \([A-Za-z0-9_.]*\) where$/\1/p' "$file"; fi; done < <(sources) | sort -u > "$unsafe_modules"; }
extract_global() { sed -n '/^-- BEGIN MIRTH-SYNC GLOBAL OPTIONS$/,/^-- END MIRTH-SYNC GLOBAL OPTIONS$/p' \"$canonical\" > \"$global\"; }; make_imports() { { echo \"-- BEGIN MIRTH-SYNC GLOBAL IMPORTS\"; module_imports | sed \"s/^/import /\"; echo \"-- END MIRTH-SYNC GLOBAL IMPORTS\"; } > \"$imports\"; }; check_global_file() { file=\"$1\"; test \"$(grep -Fc -- \"-- BEGIN MIRTH-SYNC GLOBAL OPTIONS\" \"$file\" || true)\" -eq 1; test \"$(grep -Fc -- \"-- END MIRTH-SYNC GLOBAL OPTIONS\" \"$file\" || true)\" -eq 1; actual=$(mktemp); sed -n '/^-- BEGIN MIRTH-SYNC GLOBAL OPTIONS$/,/^-- END MIRTH-SYNC GLOBAL OPTIONS$/p' \"$file\" > \"$actual\"; cmp -s \"$global\" \"$actual\"; status=$?; rm -f \"$actual\"; return \"$status\"; }; check_imports() { actual=$(mktemp); sed -n '/^-- BEGIN MIRTH-SYNC GLOBAL IMPORTS$/,/^-- END MIRTH-SYNC GLOBAL IMPORTS$/p' \"$canonical\" > \"$actual\"; cmp -s \"$imports\" \"$actual\" || { rm -f \"$actual\"; return 1; }; sed -n '/^-- BEGIN MIRTH-SYNC GLOBAL IMPORTS$/,/^-- END MIRTH-SYNC GLOBAL IMPORTS$/p' \"$theorem\" > \"$actual\"; cmp -s \"$imports\" \"$actual\"; status=$?; rm -f \"$actual\"; return \"$status\"; }; check_clones() { failures=0; while IFS= read -r file; do case \"$file\" in FullCoupled/CanonicalLearnerMonolith.agda|FullCoupled/TheoremsMonolith.agda) continue;; esac; if grep -Fq -- \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" \"$file\" || grep -Fq -- \"-- END MIRTH-SYNC COMMON IMPORTS\" \"$file\" || grep -Fq -- \"-- BEGIN MIRTH-SYNC GLOBAL IMPORTS\" \"$file\" || grep -Fq -- \"-- END MIRTH-SYNC GLOBAL IMPORTS\" \"$file\"; then echo \"clone import block must remain source-local: $file\" >&2; failures=$((failures + 1)); fi; case \"$file\" in FullCoupled/FormalMethods/*.agda|FullCoupled/FormalMethods/*/*.agda) grep -Fq -- \"{-# OPTIONS --safe #-}\" \"$file\" || { echo \"missing clone --safe: $file\" >&2; failures=$((failures + 1)); };; esac; done < <(sources); test \"$failures\" -eq 0; }; rewrite_options() { file=\"$1\"; tmp=\"$file.mirth-tmp\"; awk -v block=\"$global\" 'BEGIN { inside=0 } $0 == \"-- BEGIN MIRTH-SYNC GLOBAL OPTIONS\" { while ((getline line < block) > 0) print line; inside=1; next } $0 == \"-- END MIRTH-SYNC GLOBAL OPTIONS\" { inside=0; next } !inside { print }' \"$file\" > \"$tmp\"; mv \"$tmp\" \"$file\"; }; rewrite_imports() { for file in \"$canonical\" \"$theorem\"; do tmp=\"$file.mirth-tmp\"; awk -v block=\"$imports\" 'BEGIN { inside=0 } $0 == \"-- BEGIN MIRTH-SYNC GLOBAL IMPORTS\" { while ((getline line < block) > 0) print line; inside=1; next } $0 == \"-- END MIRTH-SYNC GLOBAL IMPORTS\" { inside=0; next } !inside { print }' \"$file\" > \"$tmp\"; mv \"$tmp\" \"$file\"; done; }; extract_global; extract_unsafe; make_imports; make_safe_imports; if [ \"$mode\" = \"--check\" ]; then failures=0; while IFS= read -r file; do check_global_file \"$file\" || { echo \"global option drift: $file\" >&2; failures=$((failures + 1)); }; done < <(sources); check_imports || { echo \"global import manifest drift\" >&2; failures=$((failures + 1)); }; check_clones || failures=$((failures + 1)); test \"$failures\" -eq 0; elif [ \"$mode\" = \"--write\" ]; then acquire_lock; while IFS= read -r file; do rewrite_options \"$file\"; done < <(sources); make_imports; make_safe_imports; rewrite_imports; check_imports; check_clones; while IFS= read -r file; do check_global_file \"$file\" || { echo \"global option sync failed: $file\" >&2; exit 1; }; done < <(sources); else echo \"usage: agda-import-sync [--write|--check]\" >&2; exit 2; fi; count=$(sources | wc -l | tr -d \" \"); echo \"mirth-agda-import-sync=pass\"; echo \"canonical=$canonical\"; echo \"synced-agda-files=$count\"; echo \"global-options=canonical-learner-to-all-tracked-agda\"; echo \"global-imports=all-tracked-agda-module-roots\"; echo \"common-imports=canonical-learner-to-theorem-only\"; echo \"clone-imports=source-local\"; echo \"clone-safe=required\"" print
}
