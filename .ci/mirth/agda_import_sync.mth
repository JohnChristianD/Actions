module actions.agda_import_sync

import std.prelude
import std.world

def main {
    "set -euo pipefail; mode=\"${1:---write}\"; canonical=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; lockdir=.ci/.mirth-agda-import-sync.lock; global=$(mktemp); import_block=$(mktemp); trap 'rm -f \"$global\" \"$import_block\"; rmdir \"$lockdir\" 2>/dev/null || true' EXIT INT TERM; acquire_lock() { attempt=0; until mkdir \"$lockdir\" 2>/dev/null; do attempt=$((attempt + 1)); if [ \"$attempt\" -ge 200 ]; then echo \"mirth-agda-import-sync: lock timeout\" >&2; exit 1; fi; sleep 0.05; done; }; sources() { git ls-files \"*.agda\"; }; extract_global() { sed -n '/^-- BEGIN MIRTH-SYNC GLOBAL OPTIONS$/,/^-- END MIRTH-SYNC GLOBAL OPTIONS$/p' \"$canonical\" > \"$global\"; }; extract_import() { sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$canonical\" > \"$import_block\"; }; check_global_file() { file=\"$1\"; test \"$(grep -Fc -- \"-- BEGIN MIRTH-SYNC GLOBAL OPTIONS\" \"$file\" || true)\" -eq 1; test \"$(grep -Fc -- \"-- END MIRTH-SYNC GLOBAL OPTIONS\" \"$file\" || true)\" -eq 1; actual=$(mktemp); sed -n '/^-- BEGIN MIRTH-SYNC GLOBAL OPTIONS$/,/^-- END MIRTH-SYNC GLOBAL OPTIONS$/p' \"$file\" > \"$actual\"; cmp -s \"$global\" \"$actual\"; status=$?; rm -f \"$actual\"; return $status; }; check_monolith_imports() { test \"$(grep -Fc -- \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" \"$canonical\")\" -eq 1; test \"$(grep -Fc -- \"-- END MIRTH-SYNC COMMON IMPORTS\" \"$canonical\")\" -eq 1; test \"$(grep -Fc -- \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" \"$theorem\")\" -eq 1; test \"$(grep -Fc -- \"-- END MIRTH-SYNC COMMON IMPORTS\" \"$theorem\")\" -eq 1; actual=$(mktemp); sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$theorem\" > \"$actual\"; cmp -s \"$import_block\" \"$actual\"; status=$?; rm -f \"$actual\"; return $status; }; check_clones() { failures=0; while IFS= read -r file; do case \"$file\" in FullCoupled/CanonicalLearnerMonolith.agda|FullCoupled/TheoremsMonolith.agda) continue;; esac; if grep -Fq -- \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" \"$file\" || grep -Fq -- \"-- END MIRTH-SYNC COMMON IMPORTS\" \"$file\"; then echo \"clone import block must remain local: $file\" >&2; failures=$((failures + 1)); fi; case \"$file\" in FullCoupled/FormalMethods/*.agda|FullCoupled/FormalMethods/*/*.agda) grep -Fq -- \"{-# OPTIONS --safe #-}\" \"$file\" || { echo \"missing clone --safe: $file\" >&2; failures=$((failures + 1)); };; esac; done < <(sources); test \"$failures\" -eq 0; }; rewrite_global() { file=\"$1\"; tmp=\"$file.mirth-tmp\"; if grep -Fq -- \"-- BEGIN MIRTH-SYNC GLOBAL OPTIONS\" \"$file\"; then awk -v block=\"$global\" 'BEGIN { inside=0 } $0 == \"-- BEGIN MIRTH-SYNC GLOBAL OPTIONS\" { while ((getline line < block) > 0) print line; inside=1; next } $0 == \"-- END MIRTH-SYNC GLOBAL OPTIONS\" { inside=0; next } !inside { print }' \"$file\" > \"$tmp\"; else { cat \"$global\"; printf \"\n\"; cat \"$file\"; } > \"$tmp\"; fi; cmp -s \"$file\" \"$tmp\" || mv \"$tmp\" \"$file\"; rm -f \"$tmp\"; }; rewrite_theorem_imports() { tmp=\"$theorem.mirth-tmp\"; awk -v block=\"$import_block\" 'BEGIN { inside=0 } $0 == \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" { while ((getline line < block) > 0) print line; inside=1; next } $0 == \"-- END MIRTH-SYNC COMMON IMPORTS\" { inside=0; next } !inside { print }' \"$theorem\" > \"$tmp\"; mv \"$tmp\" \"$theorem\"; }; remove_clone_imports() { while IFS= read -r file; do case \"$file\" in FullCoupled/CanonicalLearnerMonolith.agda|FullCoupled/TheoremsMonolith.agda) continue;; esac; if grep -Fq -- \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" \"$file\"; then tmp=\"$file.mirth-tmp\"; awk '$0 == \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" { inside=1; next } $0 == \"-- END MIRTH-SYNC COMMON IMPORTS\" { inside=0; next } !inside { print }' \"$file\" > \"$tmp\"; mv \"$tmp\" \"$file\"; fi; done < <(sources); }; extract_global; extract_import; if [ \"$mode\" = \"--check\" ]; then failures=0; while IFS= read -r file; do check_global_file \"$file\" || { echo \"global option drift: $file\" >&2; failures=$((failures + 1)); }; done < <(sources); check_monolith_imports || { echo \"monolith import drift\" >&2; failures=$((failures + 1)); }; check_clones || failures=$((failures + 1)); test \"$failures\" -eq 0; elif [ \"$mode\" = \"--write\" ]; then acquire_lock; while IFS= read -r file; do rewrite_global \"$file\"; done < <(sources); rewrite_theorem_imports; remove_clone_imports; while IFS= read -r file; do check_global_file \"$file\" || { echo \"global option sync failed: $file\" >&2; exit 1; }; done < <(sources); check_monolith_imports; check_clones; else echo \"usage: agda-import-sync [--write|--check]\" >&2; exit 2; fi; count=$(sources | wc -l | tr -d \" \"); echo \"mirth-agda-import-sync=pass\"; echo \"canonical=$canonical\"; echo \"synced-agda-files=$count\"; echo \"global-options=canonical-to-all-tracked-agda\"; echo \"common-imports=canonical-learner-to-theorem-only\"; echo \"clone-imports=source-local\"; echo \"clone-safe=required\"" print
}
