module actions.agda_import_sync

import std.prelude
import std.world

def main {
    "python3 -c 'from pathlib import Path; import re,sys; L=Path('Exotic/FullCoupled/CanonicalLearnerMonolith.agda'); T=Path('Exotic/FullCoupled/TheoremsMonolith.agda'); mode=sys.argv[1] if len(sys.argv)>1 else '--check'; B='-- BEGIN MIRTH-SYNC COMMON IMPORTS'; E='-- END MIRTH-SYNC COMMON IMPORTS'; p=re.compile(re.escape(B)+r'.*?'+re.escape(E),re.S); l=L.read_text(); t=T.read_text(); m=p.search(l); assert m and len(p.findall(l))==1; block=m.group(0); assert len(p.findall(t))==1; new=p.sub(block,t,count=1); (T.write_text(new) if mode=='--write' else None); t=new if mode=='--write' else t; assert p.findall(l)==p.findall(t); assert t.splitlines().count('open import Exotic.FullCoupled.CanonicalLearnerMonolith as C')==1; assert not any(x.startswith(('open import Exotic.FullCoupled.','import Exotic.FullCoupled.')) and x!='open import Exotic.FullCoupled.CanonicalLearnerMonolith as C' for x in t.splitlines()); assert t.count('import SMT.Theories.Ints as Ints')==1; assert t.count('open import SMT.Backend.Z3 Ints.theory')==1; assert t.count('import Vehicle')==1; print('mirth-agda-import-sync=pass'); print('shared-import-block=byte-identical'); print('cross-monolith-dependency=learner-to-theorem-only')'" print
}
