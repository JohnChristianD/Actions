module actions.agda_import_sync

import std.prelude
import std.world

def main {
    "set -euo pipefail; mode=\"${1:---check}\"; learner=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; lockdir=.ci/.mirth-agda-import-sync.lock; block=$(mktemp); candidate=$(mktemp); trap 'rm -f \"$block\" \"$candidate\"; rmdir \"$lockdir\" 2>/dev/null || true' EXIT INT TERM; acquire_lock() { attempt=0; until mkdir \"$lockdir\" 2>/dev/null; do attempt=$((attempt + 1)); if [ \"$attempt\" -ge 200 ]; then echo 'mirth-agda-import-sync: lock timeout' >&2; exit 1; fi; sleep 0.05; done; }; extract_block() { sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$learner\" > \"$block\"; }; check_markers() { test \"$(grep -Fc -- '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$learner\")\" -eq 1; test \"$(grep -Fc -- '-- END MIRTH-SYNC COMMON IMPORTS' \"$learner\")\" -eq 1; test \"$(grep -Fc -- '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$theorem\")\" -eq 1; test \"$(grep -Fc -- '-- END MIRTH-SYNC COMMON IMPORTS' \"$theorem\")\" -eq 1; }; check_blocks() { theorem_block=$(mktemp); sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$theorem\" > \"$theorem_block\"; if cmp -s \"$block\" \"$theorem_block\"; then rm -f \"$theorem_block\"; return 0; else rm -f \"$theorem_block\"; return 1; fi; }; check_direction() { test \"$(grep -Ec '^(open import|import) FullCoupled\\.' \"$learner\")\" -eq 0; test \"$(grep -Fc -- 'open import FullCoupled.CanonicalLearnerMonolith as C' \"$theorem\")\" -eq 1; test \"$(grep -Ec '^(open import|import) FullCoupled\\.' \"$theorem\")\" -eq 1; }; check_solver_surface() { for import_name in 'Data.Bool.Solver' 'Data.Nat.Solver' 'Data.Integer.Solver' 'Data.Rational.Solver' 'Data.Rational.Unnormalised.Solver' 'Data.List.Relation.Binary.Sublist.Heterogeneous.Solver' 'Data.List.Relation.Binary.Sublist.DecSetoid.Solver' 'Data.List.Relation.Binary.Sublist.DecPropositional.Solver' 'Data.Nat.Tactic.RingSolver' 'Data.Integer.Tactic.RingSolver' 'Data.Rational.Tactic.RingSolver' 'Data.Rational.Unnormalised.Tactic.RingSolver' 'Tactic.MonoidSolver' 'Tactic.RingSolver' 'Function.Related.TypeIsomorphisms.Solver'; do grep -Fq -- \"$import_name\" \"$learner\" || return 1; done; for base_name in 'Data.Bool.Base' 'Data.Nat.Base' 'Data.Integer.Base' 'Data.Rational.Base' 'Data.Rational.Unnormalised.Base' 'Data.List.Base' 'Data.Product.Base' 'Data.Sum.Base' 'Data.Maybe.Base' 'Data.Fin.Base' 'Data.Vec.Base' 'Tactic.RingSolver.Core.Polynomial.Base'; do grep -Fq -- \"$base_name\" \"$learner\" || return 1; done; }; check_external() { test \"$(grep -Fc -- 'import Vehicle' \"$theorem\")\" -eq 1; }; check_all_concurrent() { failures=0; check_markers & p1=$!; check_blocks & p2=$!; check_direction & p3=$!; check_external & p4=$!; check_solver_surface & p5=$!; for pid in \"$p1\" \"$p2\" \"$p3\" \"$p4\" \"$p5\"; do if wait \"$pid\"; then :; else failures=$((failures + 1)); fi; done; test \"$failures\" -eq 0; }; extract_block; check_markers; case \"$mode\" in --check) check_all_concurrent ;; --write) acquire_lock; awk -v block=\"$block\" 'BEGIN{inside=0} $0==\"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" {while((getline line < block)>0) print line; inside=1; next} $0==\"-- END MIRTH-SYNC COMMON IMPORTS\" {inside=0; next} !inside{print}' \"$theorem\" > \"$candidate\"; mv \"$candidate\" \"$theorem\"; check_all_concurrent ;; *) echo 'usage: agda-import-sync [--check|--write]' >&2; exit 2 ;; esac; echo 'mirth-agda-import-sync=pass'; echo 'shared-import-block=byte-identical'; echo 'cross-monolith-dependency=learner-to-theorem-only'; echo 'concurrent-predicates=markers,blocks,direction,vehicle-import,solver-surface'; echo 'write-path=lock-protected' " print
}
