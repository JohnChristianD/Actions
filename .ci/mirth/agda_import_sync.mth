module actions.agda_import_sync

import std.prelude
import std.world

def main {
    "set -euo pipefail; mode=\"${1:---check}\"; learner=FullCoupled/CanonicalLearnerMonolith.agda; theorem=FullCoupled/TheoremsMonolith.agda; block=$(mktemp); updated=$(mktemp); trap 'rm -f \"$block\" \"$updated\"' EXIT; sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$learner\" > \"$block\"; test \"$(grep -Fc '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$learner\")\" -eq 1; test \"$(grep -Fc '-- END MIRTH-SYNC COMMON IMPORTS' \"$learner\")\" -eq 1; test \"$(grep -Fc '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$theorem\")\" -eq 1; test \"$(grep -Fc '-- END MIRTH-SYNC COMMON IMPORTS' \"$theorem\")\" -eq 1; awk -v block=\"$block\" 'BEGIN{inside=0} $0==\"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" {while((getline line < block)>0) print line; inside=1; next} $0==\"-- END MIRTH-SYNC COMMON IMPORTS\" {inside=0; next} !inside{print}' \"$theorem\" > \"$updated\"; if [ \"$mode\" = \"--write\" ]; then mv \"$updated\" \"$theorem\"; cp \"$theorem\" \"$updated\"; fi; test \"$(sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$theorem\")\" = \"$(cat \"$block\")\"; test \"$(grep -Fc 'open import FullCoupled.CanonicalLearnerMonolith as C' \"$theorem\")\" -eq 1; test \"$(grep -Ec '^(open import|import) FullCoupled\\\\.' \"$theorem\")\" -eq 1; test \"$(grep -Fc 'import SMT.Theories.Ints as Ints' \"$theorem\")\" -eq 1; test \"$(grep -Fc 'open import SMT.Backend.Z3 Ints.theory' \"$theorem\")\" -eq 1; test \"$(grep -Fc 'import Vehicle' \"$theorem\")\" -eq 1; echo 'mirth-agda-import-sync=pass'; echo 'shared-import-block=byte-identical'; echo 'cross-monolith-dependency=learner-to-theorem-only'" print
}
