module actions.agda_import_sync

import std.prelude
import std.world

def main {
    "set -euo pipefail; mode=\"--write\"; if [ \"$#\" -gt 0 ]; then mode=\"$1\"; fi; canonical=FullCoupled/CanonicalLearnerMonolith.agda; lockdir=.ci/.mirth-agda-import-sync.lock; block=$(mktemp); trap 'rm -f \"$block\"; rmdir \"$lockdir\" 2>/dev/null || true' EXIT INT TERM; acquire_lock() { attempt=0; until mkdir \"$lockdir\" 2>/dev/null; do attempt=$((attempt + 1)); if [ \"$attempt\" -ge 200 ]; then echo 'mirth-agda-import-sync: lock timeout' >&2; exit 1; fi; sleep 0.05; done; }; extract_block() { sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$canonical\" > \"$block\"; }; sources() { git ls-files '*.agda'; }; check_file() { file=\"$1\"; begin=$(grep -Fc -- '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$file\" || true); end=$(grep -Fc -- '-- END MIRTH-SYNC COMMON IMPORTS' \"$file\" || true); [ \"$begin\" -eq 1 ] || { echo \"bad begin marker: $file\" >&2; return 1; }; [ \"$end\" -eq 1 ] || { echo \"bad end marker: $file\" >&2; return 1; }; actual=$(mktemp); sed -n '/^-- BEGIN MIRTH-SYNC COMMON IMPORTS$/,/^-- END MIRTH-SYNC COMMON IMPORTS$/p' \"$file\" > \"$actual\"; cmp -s \"$block\" \"$actual\"; status=$?; rm -f \"$actual\"; return $status; }; rewrite_file() { file=\"$1\"; tmp=\"$file.mirth-tmp\"; if grep -Fq -- '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$file\"; then awk -v block=\"$block\" 'BEGIN { inside=0 } $0 == \"-- BEGIN MIRTH-SYNC COMMON IMPORTS\" { while ((getline line < block) > 0) print line; inside=1; next } $0 == \"-- END MIRTH-SYNC COMMON IMPORTS\" { inside=0; next } !inside { print }' \"$file\" > \"$tmp\"; else awk -v block=\"$block\" 'BEGIN { inserted=0 } !inserted && $0 ~ /^module[[:space:]].* where[[:space:]]*$/ { print; print; while ((getline line < block) > 0) print line; inserted=1; next } { print } END { if (!inserted) exit 1 }' \"$file\" > \"$tmp\"; fi; cmp -s \"$file\" \"$tmp\" || mv \"$tmp\" \"$file\"; rm -f \"$tmp\"; }; extract_block; grep -Fq -- '-- BEGIN MIRTH-SYNC COMMON IMPORTS' \"$canonical\"; grep -Fq -- '-- END MIRTH-SYNC COMMON IMPORTS' \"$canonical\"; case \"$mode\" in --check) failures=0; while IFS= read -r file; do check_file \"$file\" || { echo \"import drift: $file\" >&2; failures=$((failures + 1)); }; done < <(sources); [ \"$failures\" -eq 0 ] ;; --write) acquire_lock; while IFS= read -r file; do rewrite_file \"$file\"; done < <(sources); while IFS= read -r file; do check_file \"$file\" || { echo \"import sync failed: $file\" >&2; exit 1; }; done < <(sources) ;; *) echo 'usage: agda-import-sync [--write|--check]' >&2; exit 2 ;; esac; count=$(sources | wc -l | tr -d ' '); echo 'mirth-agda-import-sync=pass'; echo \"canonical=$canonical\"; echo \"synced-agda-files=$count\"; echo 'shared-import-block=byte-identical'; echo 'sync-model=canonical-to-all-tracked-agda' " print
}