module actions.agda_to_elm

import std.prelude
import std.world

def main {
    "module GeneratedTheoremSurface exposing (agdaModules, roots, directionalLabels)\n\nagdaModules : List String\nagdaModules =\n    [ \"FullCoupled.CanonicalLearnerMonolith\"\n    , \"FullCoupled.TheoremsMonolith\"\n    ]\n\nroots : List String\nroots =\n    [ \"BrouwerMixedNashExistence\"\n    , \"nashEveryFiniteGameViaBrouwer\"\n    , \"finiteMixedNash-brouwer-egraph-astar-proof\"\n    , \"finiteMixedNash-egraph-astar-convergence\"\n    , \"finiteMixedNash-egraph-astar-eventualStationarity\"\n    , \"finiteMixedNash-cycle-transport\"\n    , \"finiteMixedNash-from-GRU-tail\"\n    , \"GRUInjectiveTailStabilityConvergenceIdentifiabilityTheorem\"\n    , \"EGraphAStarFiniteRankConvergenceWitness\"\n    , \"eGraphAStarConvergenceSemanticClosure\"\n    ]\n\ndirectionalLabels : List (String, String)\ndirectionalLabels =\n    [ (\"declaration\", \"depends on Agda prerequisites\")\n    , (\"candidate\", \"references target expression\")\n    , (\"GRU tail\", \"fixes feature iterate, then source state\")\n    , (\"Brouwer fixed point\", \"identifies mixed Nash profile\")\n    , (\"A* cost\", \"guides graph search; does not prove equality\")\n    , (\"e-graph path\", \"proves semantic endpoint equality\")\n    ]\n" print
}
