module actions.agda_to_elm

import std.prelude
import std.world
import std.file
import std.str
import std.path

def read-source [ +World Path -- +World Str ] {
    read-path! match(
        { Ok -> }
        { Err -> "Mirth could not read the Agda source module" panic! }
    )
}

def require-marker [ Str Str -- Bool ] {
    thaw find some?
}

def main [ +World -- +World ] {
    "Exotic/ERL/FullCoupled/CanonicalLearnerMonolith.agda" >Path read-source
    dup "module Exotic.ERL.FullCoupled.CanonicalLearnerMonolith" require-marker
    if(
        id,
        "Canonical learner module marker missing" panic!
    )
    drop
    num-bytes >Int >canonical-bytes

    "Exotic/ERL/FullCoupled/TheoremsMonolith.agda" >Path read-source
    dup "module Exotic.ERL.FullCoupled.TheoremsMonolith" require-marker
    if(
        id,
        "Theorem module marker missing" panic!
    )
    drop
    num-bytes >Int >theorem-bytes

    +World.print {
        "module GeneratedTheoremSurface exposing (agdaModules, agdaSourceBytes)\n\n" ;
        "agdaModules : List String\n" ;
        "agdaModules =\n" ;
        "    [ \"Exotic.ERL.FullCoupled.CanonicalLearnerMonolith\"\n" ;
        "    , \"Exotic.ERL.FullCoupled.TheoremsMonolith\"\n" ;
        "    ]\n\n" ;
        "agdaSourceBytes : List Int\n" ;
        "agdaSourceBytes =\n    [ " ; @canonical-bytes repr; "\n    , " ;
        @theorem-bytes repr; "\n    ]\n\n" ;
        "syncAuthority : String\nsyncAuthority = \"Mirth reads canonical Agda sources\"\n\n" ;
        "proofAuthority : String\nproofAuthority = \"Agda --safe\"\n"
    }
}
