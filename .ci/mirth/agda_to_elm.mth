module actions.agda_to_elm

import std.prelude
import std.world

def main {
    "set -euo pipefail; repo=$(basename $GITHUB_REPOSITORY); commit=$(git rev-parse HEAD); cat <<EOF
module GeneratedTheoremSurface exposing (siteTitle, buildCommit, sourceFiles, nodeLines, edgeLines, asciiSanitize)

import Char
import GeneratedAgdaGraph as Graph
import String

siteTitle : String
siteTitle = \"$repo\"

buildCommit : String
buildCommit = \"$commit\"

sourceFiles : List String
sourceFiles =
    unique (List.map .source Graph.nodes)


unique : List String -> List String
unique values =
    uniqueHelp values []


uniqueHelp : List String -> List String -> List String
uniqueHelp values seen =
    case values of
        [] ->
            seen

        value :: rest ->
            if List.member value seen then
                uniqueHelp rest seen

            else
                uniqueHelp rest (seen ++ [ value ])


sanitizeChar : Char -> Char
sanitizeChar char =
    if Char.toCode char < 128 then
        char

    else
        Char.fromCode 63


asciiSanitize : String -> String
asciiSanitize value =
    String.map sanitizeChar value


nodeLine : Graph.Node -> String
nodeLine node =
    asciiSanitize (node.source ++ String.fromList [58] ++ node.label)


nodeLines : List String
nodeLines =
    List.map nodeLine Graph.nodes


edgeLine : Graph.Edge -> String
edgeLine edge =
    asciiSanitize
        (edge.source
            ++ String.fromList [32, 45, 45]
            ++ edge.relation
            ++ String.fromList [45, 45, 62, 32]
            ++ edge.target
        )


edgeLines : List String
edgeLines =
    List.map edgeLine Graph.edges
EOF" print
}